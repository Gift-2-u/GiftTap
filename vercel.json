{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!assets/|icons/|shop/|g2u-token\\.json|Gift2u_logo\\.png|Gift2U\\.apk|favicon\\.ico|manifest\\.webmanifest|sw\\.js|.*\\.(?:png|jpg|jpeg|gif|svg|webp|json|txt|xml|ico|js|css|map|woff2?|apk)).*)",
      "destination": "/index.html"
    }
  ]
}
